# ---- Cloudflare Pages / local frontend (.env) — PUBLIC values only ----
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ---- Supabase Edge Function secrets (NEVER put these in VITE_* or in Git) ----
# Set with: supabase secrets set --env-file supabase/.env   (supabase/.env is git-ignored)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Comma-separated list of allowed browser origins for CORS, e.g.
# http://localhost:5173,https://engsolve.pages.dev
ALLOWED_ORIGINS=
